<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SemLimites</AssemblyName>
    <RootNamespace>SemLimites</RootNamespace>
    <!-- "*" = versão mais recente da biblioteca do jogo. Se der erro, troque pela versão exata do seu Among Us (ex: 2025.9.9) -->
    <GameVersion Condition="'$(GameVersion)' == ''">*</GameVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AmongUs.GameLibs.Steam" Version="$(GameVersion)" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Reactor" Version="2.*" />
  </ItemGroup>
</Project>
